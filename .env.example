# ---------------------------------------------------------------------
# Cairn — configuration du service de synchronisation
#
# Copier en /etc/cairn/cairn.env et restreindre les droits : ce fichier
# contient la clé qui déchiffre les jetons Garmin et Strava.
#
#   sudo install -D -m 600 .env.example /etc/cairn/cairn.env
#
# L'application de bureau, elle, se configure dans sa propre fenêtre de
# réglages et n'a pas besoin de ce fichier.
# ---------------------------------------------------------------------

# --- Base ---
CAIRN_DB_DSN=postgresql://cairn:motdepasse@localhost:5432/cairn

# Racine de stockage des fichiers d'activité bruts (.fit/.gpx)
CAIRN_FILE_ROOT=/var/lib/cairn/activities

# Clé de chiffrement des credentials en base (table `credential`).
# Générer une fois :  cairn keygen
CAIRN_SECRET_KEY=

# --- Garmin Connect ---
# Pas d'API publique : authentification par session SSO (garth).
# Le token est chiffré en base ; ces identifiants ne servent qu'au bootstrap
# et à la re-authentification quand le token expire (~1 an).
CAIRN_GARMIN_EMAIL=
CAIRN_GARMIN_PASSWORD=
# Domaine : garmin.com (monde) ou garmin.cn (Chine)
CAIRN_GARMIN_DOMAIN=garmin.com

# --- Strava ---
# https://www.strava.com/settings/api  (créer une application)
CAIRN_STRAVA_CLIENT_ID=
CAIRN_STRAVA_CLIENT_SECRET=
# Rempli automatiquement par `cairn auth strava` après le flux OAuth
CAIRN_STRAVA_REDIRECT_URI=http://localhost:8000/auth/strava/callback

# --- Synchronisation ---
# Heure de la passe nocturne (cron, fuseau CAIRN_TIMEZONE)
CAIRN_SYNC_HOUR=4
CAIRN_TIMEZONE=Europe/Paris
# Nombre de jours de wellness Garmin remontés par passe de backfill.
# 60 ≈ 15 min de sync : de quoi rattraper l'historique en quelques nuits
# sans se faire jeter par Garmin.
CAIRN_BACKFILL_DAYS_PER_RUN=60
# Fenêtre de re-vérification des activités récentes (une sortie peut être
# éditée ou complétée après coup côté Strava)
CAIRN_INCREMENTAL_LOOKBACK_DAYS=14

# --- Ollama (résumé hebdomadaire) ---
# L'application de bureau embarque son propre moteur et n'a rien à
# renseigner ici. Le service, lui, a besoin d'une instance accessible.
CAIRN_OLLAMA_URL=http://localhost:11434
# Cairn calcule tous les chiffres lui-même : le modèle ne fait que les
# rédiger, et tout nombre qu'il inventerait est rejeté. Un petit modèle
# suffit donc et répond en quelques secondes.
CAIRN_OLLAMA_MODEL=qwen3:0.6b

# --- Discord (notifications) ---
# Paramètres du salon > Intégrations > Webhooks > Nouveau webhook
CAIRN_DISCORD_WEBHOOK_URL=
# Jour d'envoi du résumé hebdomadaire : 0 = lundi, 6 = dimanche
CAIRN_SUMMARY_WEEKDAY=0
